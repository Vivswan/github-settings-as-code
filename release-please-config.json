  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "1.0.0",
      "extra-files": [
        "README.md",
        "docs/getting-started.md",
        "docs/check-mode.md",
        "docs/multi-repo.md",
        "docs/migrating-from-probot.md",

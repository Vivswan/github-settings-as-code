{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!lib",
      "!src/upstream-gaps/index.ts",
      "!.github/repo-platform-manifest.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@actions/core": "Only src/action/ implements the Io port over @actions/core; every other layer takes an Io."
            },
            "patterns": [
              {
                "group": ["**/private-open", "**/private-open.*"],
                "message": "Only the redaction projections may open a Private<T> seal; render through publicDetail/toPublicView, or compose the private report."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["src/action/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/private-open", "**/private-open.*"],
                    "message": "Only the redaction projections may open a Private<T> seal; render through publicDetail/toPublicView, or compose the private report."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/action/redact.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/private.ts",
        "src/discovery/discover.ts",
        "src/report/delivery.ts",
        "test/private.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@actions/core": "Only src/action/ implements the Io port over @actions/core; every other layer takes an Io."
                }
              }
            }
          }
        }
      }
    }
  ]
}
